import json
import requests

def emotion_detector(text_to_analyze):
    """
    Analyzes the input text for emotions using the Watson NLP Emotion Detection service.
    
    Returns:
        dict: Emotion confidence scores and the dominant emotion.
    """
    # Service endpoint URL and required model metadata headers
    url = "https://sn-watson-emotion.labs.skills.network/v1/watson.runtime.nlp.v1/NlpService/EmotionPredict"
    headers = {"grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"}
    
    # Request body structure expected by the Watson NLP API
    myobj = {"raw_document": {"text": text_to_analyze}}
    
    # Send HTTP POST request to Watson NLP API
    response = requests.post(url, json=myobj, headers=headers)
    
    # Parse the JSON response text
    formatted_response = json.loads(response.text)
    
    # Extract emotion scores dictionary
    emotions = formatted_response["emotionPredictions"][0]["emotion"]
    
    anger_score = emotions["anger"]
    disgust_score = emotions["disgust"]
    fear_score = emotions["fear"]
    joy_score = emotions["joy"]
    sadness_score = emotions["sadness"]
    
    # Identify the emotion key with the maximum value
    dominant_emotion = max(emotions, key=emotions.get)
    
    # Format and return the dictionary result
    return {
        "anger": anger_score,
        "disgust": disgust_score,
        "fear": fear_score,
        "joy": joy_score,
        "sadness": sadness_score,
        "dominant_emotion": dominant_emotion,
    }

# --- Application Testing Block ---
if __name__ == "__main__":
    sample_text = "I am so happy and excited to build this project!"
    result = emotion_detector(sample_text)
    print(result)
