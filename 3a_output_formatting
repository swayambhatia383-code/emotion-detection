import json
import requests


def emotion_detector(text_to_analyse):
    """Analyzes text using Watson NLP Emotion Detection and returns a dictionary

    containing emotion scores and the dominant emotion.
    """
    # Correct URL endpoint (fixed 'emtion' typo and path)
    url = "https://sn-watson-emotion.labs.skills.network/v1/watson.runtime.nlp.v1/NlpService/EmotionPredict"

    # Correct header key and value (fixed 'grcp' typo and '=' sign)
    headers = {
        "grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"
    }

    # Payload with the correct parameter name 'text_to_analyse'
    myobj = {"raw_document": {"text": text_to_analyse}}

    # Send POST request to Watson NLP API
    response = requests.post(url, json=myobj, headers=headers)

    # Parse response JSON string into a Python dictionary
    formatted_response = json.loads(response.text)

    # Extract emotion dictionary (fixed quote mismatch)
    emotions = formatted_response["emotionPredictions"][0]["emotion"]

    # Extract individual emotion scores (fixed quote and bracket typos)
    anger_score = emotions["anger"]
    disgust_score = emotions["disgust"]
    fear_score = emotions["fear"]
    joy_score = emotions["joy"]
    sadness_score = emotions["sadness"]

    # Determine the dominant emotion
    dominant_emotion = max(emotions, key=emotions.get)

    # Return formatted dictionary
    return {
        "anger": anger_score,
        "disgust": disgust_score,
        "fear": fear_score,
        "joy": joy_score,
        "sadness": sadness_score,
        "dominant_emotion": dominant_emotion,
    }
